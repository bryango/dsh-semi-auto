{
  "name": "dsh-semi-auto",
  "version": "0.3.0",
  "description": "Native full-access approval broker with a human popup and optional official-policy Auto review for DSH",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=24", "dsh": "0.2.1-rc.3 || 0.2.1-rc.5" },
  "packageManager": "pnpm@10.26.2",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "src", "client.js", "locale", "icon.svg", "tsconfig.json", "tsconfig.build.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "cordis.patch.yml", "README.md", "UPDATING.md", "THIRD_PARTY_NOTICES.md", "LICENSE", "vendor", "scripts"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test",
    "vendor:generate": "node scripts/generate-reviewer.mjs",
    "prepack": "pnpm check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3 || 0.2.1-rc.5"
  },
  "dependencies": { "@deepseek-ai/dsh-util-values": "0.2.1-rc.5", "@deepseek-ai/schemastery": "3.18.5" },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "yaml": "2.8.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.5",
    "@types/node": "24.12.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
